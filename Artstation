    <p style="font-size:10px;color:#777;margin-bottom:15px">
      Shipping and applicable taxes are calculated during checkout.
    </p>

    <button class="full-btn" id="checkoutBtn">PROCEED TO CHECKOUT</button>
  </div>

</aside>

<!-- CHECKOUT MODAL -->

<div class="modal" id="checkoutModal">

  <div class="modal-content">

    <button class="close-btn" id="modalClose" style="float:right">×</button>

    <h2>Complete Your Order</h2>

    <p>Enter your delivery details to continue.</p>

    <form class="checkout-form" id="checkoutForm">

      <input type="text" id="customerName" placeholder="Full name" required>

      <input type="email" id="customerEmail" placeholder="Email address" required>

      <input type="text" id="customerAddress" placeholder="Street address" required>

      <input type="text" id="customerCity" placeholder="City" required>

      <input type="text" id="customerPostal" placeholder="ZIP / Postal code" required>

      <select id="customerCountry" required>
        <option value="">Select country</option>
        <option>United States</option>
        <option>United Kingdom</option>
        <option>Canada</option>
        <option>Australia</option>
        <option>Germany</option>
        <option>France</option>
        <option>Nigeria</option>
        <option>Other</option>
      </select>

      <textarea id="orderNotes" placeholder="Additional delivery instructions (optional)"></textarea>

      <div class="checkout-total">
        <span>Order subtotal</span>
        <span id="checkoutTotal">$0.00</span>
      </div>

      <button type="submit" id="payBtn">CONTINUE TO SECURE PAYMENT ↗</button>

      <div class="payment-note">
        Secure payment is handled by your configured payment provider.
        Card details must never be collected or stored by this website.
      </div>

    </form>

  </div>
</div>

<a class="whatsapp" href="https://wa.me/?text=Hello%20ARTSTATION%2C%20I%20am%20interested%20in%20your%20artwork." target="_blank" rel="noopener">WhatsApp ↗</a>

<script>

// ==================================
// ARTSTATION PRODUCT DATABASE
// ==================================

const products = [
  {
    id:1,
    name:"Golden Abstract",
    category:"Abstract",
    price:129,
    image:"https://images.unsplash.com/photo-1541961017774-22349e4a1262?auto=format&fit=crop&w=800&q=85",
    description:"Contemporary abstract canvas"
  },
  {
    id:2,
    name:"Modern Expression",
    category:"Modern",
    price:159,
    image:"https://images.unsplash.com/photo-1577083552431-6e5fd01aa342?auto=format&fit=crop&w=800&q=85",
    description:"Modern decorative artwork"
  },
  {
    id:3,
    name:"Nature's Beauty",
    category:"Nature",
    price:99,
    image:"https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=800&q=85",
    description:"Nature inspired wall art"
  },
  {
    id:4,
    name:"Colour Harmony",
    category:"Abstract",
    price:189,
    image:"https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=800&q=85",
    description:"Premium artistic print"
  },
  {
    id:5,
    name:"Minimalist Vision",
    category:"Modern",
    price:119,
    image:"https://images.unsplash.com/photo-1549490349-8643362247b5?auto=format&fit=crop&w=800&q=85",
    description:"Minimalist interior artwork"
  },
  {
    id:6,
    name:"Landscape Dreams",
    category:"Nature",
    price:145,
    image:"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=85",
    description:"Nature and landscape print"
  }
];

// FRAME PRICES

const frames = {
  "No Frame":0,
  "Black Frame":25,
  "White Frame":25,
  "Natural Wood Frame":35,
  "Premium Gold Frame":55
};

// CART

let cart = JSON.parse(localStorage.getItem("artstationCart") || "[]");

let activeFilter = "All";
let searchTerm = "";

// MONEY FORMAT

const money = amount => new Intl.NumberFormat("en-US",{
  style:"currency",
  currency:"USD"
}).format(amount);

// RENDER PRODUCTS

function renderProducts(){

  let list = products.filter(product => {

    const matchesCategory =
      activeFilter === "All" ||
      product.category === activeFilter;

    const matchesSearch =
      product.name.toLowerCase().includes(searchTerm) ||
      product.category.toLowerCase().includes(searchTerm);

    return matchesCategory && matchesSearch;
  });

  const sort = document.getElementById("sort").value;

  if(sort === "low") list.sort((a,b)=>a.price-b.price);
  if(sort === "high") list.sort((a,b)=>b.price-a.price);

  const grid = document.getElementById("productGrid");

  if(!list.length){
    grid.innerHTML='<div class="no-results">No artwork found. Try another search.</div>';
    return;
  }

  grid.innerHTML = list.map(product => `

    <article class="product-card">

      <div class="product-image">
        <img src="${product.image}" alt="${product.name}" loading="lazy">
        <span class="tag">${product.category.toUpperCase()}</span>
      </div>

      <div class="product-info">

        <h3>${product.name}</h3>

        <p>${product.description}</p>

        <div class="price">${money(product.price)}</div>

        <div class="product-controls">

          <select class="frame-select" id="frame-${product.id}" aria-label="Choose frame for ${product.name}">
            ${Object.entries(frames).map(([name,price])=>
              `<option value="${name}">${name}${price ? " (+"+money(price)+")" : ""}</option>`
            ).join("")}
          </select>

          <button class="add-btn" onclick="addToCart(${product.id})">
            ADD TO CART +
          </button>

        </div>

      </div>

    </article>

  `).join("");
}

// ADD TO CART

function addToCart(id){

  const product = products.find(p=>p.id===id);

  const frame = document.getElementById("frame-"+id).value;

  const existing = cart.find(item=>
    item.id===id && item.frame===frame
  );

  if(existing){
    existing.quantity++;
  } else {
    cart.push({
      id:product.id,
      name:product.name,
      image:product.image,
      price:product.price,
      frame:frame,
      framePrice:frames[frame],
      quantity:1
    });
  }

  saveCart();

  alert(product.name+" added to your shopping cart.");
}

// SAVE CART

function saveCart(){
  localStorage.setItem("artstationCart",JSON.stringify(cart));
  renderCart();
}

// CART TOTAL

function getTotal(){
  return cart.reduce((total,item)=>
    total+(item.price+item.framePrice)*item.quantity,0
  );
}

// RENDER CART

function renderCart(){

  document.getElementById("cartCount").textContent =
    cart.reduce((total,item)=>total+item.quantity,0);

  document.getElementById("cartTotal").textContent =
    money(getTotal());

  document.getElementById("checkoutTotal").textContent =
    money(getTotal());

  const container = document.getElementById("cartItems");

  if(!cart.length){
    container.innerHTML='<div class="empty-cart">Your cart is currently empty.</div>';
    return;
  }

  container.innerHTML=cart.map((item,index)=>`

    <div class="cart-item">

      <img src="${item.image}" alt="${item.name}">

      <div>
        <h4>${item.name}</h4>
        <p>${item.frame}</p>
        <p>${money((item.price+item.framePrice)*item.quantity)}</p>

        <button onclick="changeQuantity(${index},-1)">−</button>

        <span style="padding:0 10px;font-size:12px">
          ${item.quantity}
        </span>

        <button onclick="changeQuantity(${index},1)">+</button>

        <button onclick="removeItem(${index})" style="margin-left:12px">
          Remove
        </button>
      </div>

    </div>

  `).join("");
}

// QUANTITY

function changeQuantity(index,change){

  cart[index].quantity+=change;

  if(cart[index].quantity<=0){
    cart.splice(index,1);
  }

  saveCart();
}

// REMOVE

function removeItem(index){
  cart.splice(index,1);
  saveCart();
}

// OPEN / CLOSE CART

const drawer=document.getElementById("cartDrawer");
const overlay=document.getElementById("overlay");

function openCart(){
  drawer.classList.add("show");
  overlay.classList.add("show");
}

function closeCart(){
  drawer.classList.remove("show");
  overlay.classList.remove("show");
}

document.getElementById("cartOpen").onclick=openCart;
document.getElementById("cartClose").onclick=closeCart;
overlay.onclick=closeCart;

// CHECKOUT

const checkoutModal=document.getElementById("checkoutModal");

document.getElementById("checkoutBtn").onclick=()=>{

  if(!cart.length){
    alert("Your shopping cart is empty.");
    return;
  }

  checkoutModal.classList.add("show");
};

document.getElementById("modalClose").onclick=()=>{
  checkoutModal.classList.remove("show");
};

// PAYMENT CONFIGURATION
// Replace with your own HTTPS backend endpoint.
// Do not place Stripe secret keys here.

const PAYMENT_API = "";

// SUBMIT CHECKOUT

document.getElementById("checkoutForm").addEventListener("submit",async function(e){

  e.preventDefault();

  if(!cart.length){
    alert("Your cart is empty.");
    return;
  }

  const order = {
    customer:{
      name:document.getElementById("customerName").value,
      email:document.getElementById("customerEmail").value,
      address:document.getElementById("customerAddress").value,
      city:document.getElementById("customerCity").value,
      postalCode:document.getElementById("customerPostal").value,
      country:document.getElementById("customerCountry").value,
      notes:document.getElementById("orderNotes").value
    },
    items:cart.map(item=>({
      productId:item.id,
      frame:item.frame,
      quantity:item.quantity
    }))
  };

  if(!PAYMENT_API){
    alert(
      "Your shopping cart and checkout form are ready! Online payment has not been activated yet. Please connect the secure payment server before accepting orders."
    );
    return;
  }

  const button=document.getElementById("payBtn");
  button.disabled=true;
  button.textContent="CONNECTING TO SECURE PAYMENT...";

  try{

    const response=await fetch(PAYMENT_API,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(order)
    });

    if(!response.ok) throw new Error("Payment service error");

    const result=await response.json();

    if(!result.url || !result.url.startsWith("https://")){
      throw new Error("Invalid checkout URL");
    }

    window.location.href=result.url;

  }catch(error){

    alert("Payment could not be started. Please try again or contact ARTSTATION.");

  }finally{

    button.disabled=false;
    button.textContent="CONTINUE TO SECURE PAYMENT ↗";

  }

});

// CATEGORY FILTERS

document.querySelectorAll(".filter-btn").forEach(button=>{

  button.addEventListener("click",()=>{

    document.querySelectorAll(".filter-btn").forEach(btn=>
      btn.classList.remove("active")
    );

    button.classList.add("active");

    activeFilter=button.dataset.filter;

    renderProducts();
  });

});

// CATEGORY IMAGE CLICK

document.querySelectorAll(".category").forEach(category=>{

  category.addEventListener("click",()=>{

    activeFilter=category.dataset.category;

    document.querySelectorAll(".filter-btn").forEach(btn=>{
      btn.classList.toggle("active",btn.dataset.filter===activeFilter);
    });

    renderProducts();
  });

});

// SEARCH

document.getElementById("search").addEventListener("input",e=>{
  searchTerm=e.target.value.toLowerCase().trim();
  renderProducts();
});

// SORT

document.getElementById("sort").addEventListener("change",renderProducts);

// MOBILE MENU

document.getElementById("menuBtn").onclick=()=>{
  document.getElementById("navLinks").classList.toggle("active");
};

document.querySelectorAll(".nav-links a").forEach(link=>{
  link.onclick=()=>{
    document.getElementById("navLinks").classList.remove("active");
  };
});

// FAQ

document.querySelectorAll(".faq-question").forEach(button=>{

  button.addEventListener("click",()=>{

    const item=button.parentElement;
    item.classList.toggle("open");

    button.querySelector("span").textContent=
      item.classList.contains("open") ? "−" : "+";

  });

});

// NEWSLETTER

document.getElementById("newsletterForm").onsubmit=e=>{

  e.preventDefault();

  const email=document.getElementById("newsletterEmail").value;

  const subject=encodeURIComponent("ARTSTATION Newsletter Subscription");

  const body=encodeURIComponent("Please add this email to the newsletter list: "+email);

  window.location.href=
    "mailto:artwork@gmail.com?subject="+subject+"&body="+body;

};

// YEAR

document.getElementById("year").textContent=new Date().getFullYear();

// INITIALIZE

renderProducts();
renderCart();

</script>

</body>
</html>
