<!-- SHOPPING CART -->

<div class="overlay" id="overlay"></div>

<aside class="cart-drawer" id="cartDrawer">

  <div class="drawer-header">
    <h2>Your Shopping Cart</h2>
    <button class="close-btn" id="cartClose">×</button>
